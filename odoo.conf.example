[options]
; Admin / database manager master password (change for anything non-local)
admin_passwd = change-me

; PostgreSQL
db_host = localhost
db_port = 5432
db_user = odoo
db_password = odoo
; Windows only: PostgreSQL there can't use LC_COLLATE 'C' with a different ctype
; (Odoo's default when cloning template0), so clone template1 instead.
; Remove this line on Linux/macOS if template1 has a non-UTF8 encoding.
db_template = template1

; Paths (relative to the repository root; run odoo-bin from there, or use absolute paths)
addons_path = odoo/addons,odoo/odoo/addons,custom_addons
data_dir = data

; Server
http_port = 8069
http_interface = 127.0.0.1
; Uncomment to also write logs to a file:
; logfile = E:/Clients/odoo Projects/clinicOS/logs/odoo.log
log_level = info

; Dev convenience
; Set to True to load demo data into newly created databases
with_demo = False
limit_time_cpu = 600
; 0 = no watchdog. The threaded dev server otherwise counts idle keep-alive
; connections as long requests and "reloads" (which exits on Windows).
limit_time_real = 0
