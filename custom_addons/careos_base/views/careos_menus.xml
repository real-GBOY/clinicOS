<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The CareOS application: a fullscreen client action, so the Odoo navbar
         never appears inside the product. -->
    <record id="action_careos_app" model="ir.actions.client">
        <field name="name">CareOS</field>
        <field name="tag">careos.app</field>
        <field name="target">fullscreen</field>
    </record>

    <menuitem id="menu_careos_root"
              name="CareOS"
              action="action_careos_app"
              web_icon="careos_base,static/description/icon.png"
              groups="group_careos_user"
              sequence="1"/>

    <!-- Organization configuration (admin). Until the CareOS settings workspace
         ships, these use standard list/form views. -->
    <menuitem id="menu_careos_config_root" name="CareOS Configuration"
              groups="group_careos_admin,base.group_system" sequence="90"/>
    <menuitem id="menu_careos_config_branch" parent="menu_careos_config_root"
              action="careos_branch_action" sequence="10"/>
    <menuitem id="menu_careos_config_department" parent="menu_careos_config_root"
              action="careos_department_action" sequence="20"/>
</odoo>
