<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_careos_branch_company" model="ir.rule">
            <field name="name">CareOS branch: multi-company</field>
            <field name="model_id" ref="model_careos_branch"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_careos_department_company" model="ir.rule">
            <field name="name">CareOS department: multi-company</field>
            <field name="model_id" ref="model_careos_department"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_careos_notification_own" model="ir.rule">
            <field name="name">CareOS notification: own only</field>
            <field name="model_id" ref="model_careos_notification"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>
    </data>
</odoo>
