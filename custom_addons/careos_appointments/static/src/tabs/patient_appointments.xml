<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="careos_appointments.PatientAppointments">
        <div class="co-p360-appointments">
            <div class="co-p360-section__head mb-2">
                <div class="co-section-label">Upcoming</div>
                <button t-if="props.profile.can_book" type="button" class="co-btn co-btn--secondary co-btn--sm" name="book_for_patient" t-on-click="book">+ Book appointment</button>
            </div>
            <EmptyState t-if="state.error" title="'Appointments unavailable'" body="state.error" error="true"/>
            <LoadingState t-elif="!state.data" rows="3"/>
            <t t-else="">
                <div t-if="!state.data.upcoming.length" class="co-muted co-list-row mb-3">No upcoming appointments.</div>
                <div t-else="" class="co-table-scroll mb-4">
                    <t t-call="careos_appointments.PatientAppointmentRows">
                        <t t-set="rows" t-value="state.data.upcoming"/>
                        <t t-set="withActions" t-value="true"/>
                    </t>
                </div>
                <div class="co-section-label">History</div>
                <div t-if="!state.data.past.length" class="co-muted co-list-row">No past appointments.</div>
                <div t-else="" class="co-table-scroll">
                    <t t-call="careos_appointments.PatientAppointmentRows">
                        <t t-set="rows" t-value="state.data.past"/>
                        <t t-set="withActions" t-value="false"/>
                    </t>
                </div>
            </t>
        </div>
    </t>

    <t t-name="careos_appointments.PatientAppointmentRows">
        <table class="co-table co-table--interactive">
            <thead><tr><th>When</th><th>Provider</th><th class="co-hide-sm">Type</th><th>Status</th><th/></tr></thead>
            <tbody>
                <t t-foreach="rows" t-as="appt" t-key="appt.id">
                    <tr t-on-click="() => this.open(appt)" tabindex="0" t-on-keydown="(ev) => ev.key === 'Enter' and this.open(appt)">
                        <td class="co-table__primary" t-esc="when(appt)"/>
                        <td t-esc="appt.provider.name"/>
                        <td class="co-hide-sm" t-esc="appt.type.name"/>
                        <td>
                            <Badge label="appt.state_label" tone="tone(appt)"/>
                            <div t-if="appt.cancel_reason" class="co-table__sub" t-esc="appt.cancel_reason"/>
                        </td>
                        <td class="text-end">
                            <AppointmentActions t-if="withActions" appointment="appt" onChanged.bind="refresh" only="['check_in']" small="true"/>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>
    </t>

    <t t-name="careos_appointments.NextAppointmentCard">
        <section class="co-next-appt" aria-label="Next appointment">
            <t t-if="appt">
                <div class="co-next-appt__body" t-on-click="open">
                    <div class="co-next-appt__label" t-esc="['checked_in', 'in_progress'].includes(appt.state) ? 'Current visit' : 'Next appointment'"/>
                    <div class="co-next-appt__when"><t t-esc="when"/> · <t t-esc="appt.provider.name"/></div>
                    <div class="co-muted small"><t t-esc="appt.type.name"/><t t-if="appt.reason"> · <t t-esc="appt.reason"/></t></div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <Badge label="appt.state_label" tone="tone"/>
                    <AppointmentActions appointment="appt" onChanged="props.reload" only="['check_in']"/>
                </div>
            </t>
            <t t-else="">
                <div>
                    <div class="co-next-appt__label">Next appointment</div>
                    <div class="co-muted small">Nothing booked.</div>
                </div>
                <button type="button" class="co-btn co-btn--secondary co-btn--sm" name="book_next" t-on-click="book">+ Book appointment</button>
            </t>
        </section>
    </t>
</templates>
