<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Operational records are branch-scoped: staff see appointments at
             the branches they are assigned to. -->
        <record id="rule_careos_appointment_branch" model="ir.rule">
            <field name="name">CareOS appointment: assigned branches</field>
            <field name="model_id" ref="model_careos_appointment"/>
            <field name="domain_force">[('branch_id', 'in', user.careos_branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('careos_base.group_careos_reception')), (4, ref('careos_base.group_careos_nurse')), (4, ref('careos_base.group_careos_manager')), (4, ref('careos_base.group_careos_admin'))]"/>
        </record>
        <!-- Doctors see their own schedule (spec section 9: "Own schedule"). -->
        <record id="rule_careos_appointment_doctor_own" model="ir.rule">
            <field name="name">CareOS appointment: doctor own schedule</field>
            <field name="model_id" ref="model_careos_appointment"/>
            <field name="domain_force">[('provider_id.user_id', '=', user.id), ('branch_id', 'in', user.careos_branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('careos_base.group_careos_doctor'))]"/>
        </record>
        <record id="rule_careos_appointment_company" model="ir.rule">
            <field name="name">CareOS appointment: multi-company</field>
            <field name="model_id" ref="model_careos_appointment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_careos_room_company" model="ir.rule">
            <field name="name">CareOS room: multi-company</field>
            <field name="model_id" ref="model_careos_room"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_careos_provider_company" model="ir.rule">
            <field name="name">CareOS provider: multi-company</field>
            <field name="model_id" ref="model_careos_provider"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
