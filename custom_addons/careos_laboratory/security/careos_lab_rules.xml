<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_careos_lab_order_doctor_own" model="ir.rule">
            <field name="name">CareOS lab order: ordering doctor</field>
            <field name="model_id" ref="model_careos_lab_order"/>
            <field name="domain_force">[('provider_id.user_id', '=', user.id), ('branch_id', 'in', user.careos_branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('careos_base.group_careos_doctor'))]"/>
        </record>
        <record id="rule_careos_lab_order_branch" model="ir.rule">
            <field name="name">CareOS lab order: lab and nursing at branch</field>
            <field name="model_id" ref="model_careos_lab_order"/>
            <field name="domain_force">[('branch_id', 'in', user.careos_branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('careos_base.group_careos_lab')), (4, ref('careos_base.group_careos_nurse'))]"/>
        </record>
        <record id="rule_careos_lab_order_company" model="ir.rule">
            <field name="name">CareOS lab order: multi-company</field>
            <field name="model_id" ref="model_careos_lab_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_careos_lab_result_company" model="ir.rule">
            <field name="name">CareOS lab result: multi-company</field>
            <field name="model_id" ref="model_careos_lab_result"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
