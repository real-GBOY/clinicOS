<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_careos_queue_ticket_branch" model="ir.rule">
            <field name="name">CareOS queue: assigned branches</field>
            <field name="model_id" ref="model_careos_queue_ticket"/>
            <field name="domain_force">[('branch_id', 'in', user.careos_branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('careos_base.group_careos_reception')), (4, ref('careos_base.group_careos_nurse')), (4, ref('careos_base.group_careos_manager')), (4, ref('careos_base.group_careos_admin'))]"/>
        </record>
        <record id="rule_careos_queue_ticket_doctor_own" model="ir.rule">
            <field name="name">CareOS queue: doctor own patients</field>
            <field name="model_id" ref="model_careos_queue_ticket"/>
            <field name="domain_force">[('provider_id.user_id', '=', user.id), ('branch_id', 'in', user.careos_branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('careos_base.group_careos_doctor'))]"/>
        </record>
        <record id="rule_careos_queue_ticket_company" model="ir.rule">
            <field name="name">CareOS queue: multi-company</field>
            <field name="model_id" ref="model_careos_queue_ticket"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
