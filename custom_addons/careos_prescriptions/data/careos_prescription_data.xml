<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_careos_prescription" model="ir.sequence">
            <field name="name">CareOS Prescription</field>
            <field name="code">careos.prescription</field>
            <field name="prefix">RX-</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
    <record id="cron_careos_complete_courses" model="ir.cron">
        <field name="name">CareOS: complete finished medication courses</field>
        <field name="model_id" ref="model_careos_prescription"/>
        <field name="state">code</field>
        <field name="code">model._careos_cron_complete_courses()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
